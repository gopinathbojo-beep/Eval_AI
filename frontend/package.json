{
  "name": "adem-frontends",
  "private": true,
  "description": "The ADEM web apps. One npm install here fills the shared node_modules for all of them.",
  "workspaces": [
    "web",
    "admin",
    "parent"
  ],
  "scripts": {
    "dev:web": "npm run dev -w adem-frontend",
    "dev:admin": "npm run dev -w adem-admin",
    "dev:parents": "npm run dev -w adem-parents",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w adem-frontend",
    "test:e2e": "npm run test:e2e -w adem-frontend"
  }
}
