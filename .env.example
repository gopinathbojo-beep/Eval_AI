# Copy to .env beside compose.yaml. Do not put real secrets in this example.
DOMAIN=eval.example.com
ACME_EMAIL=admin@example.com
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
LOGIN_ATTEMPTS_PER_MINUTE=20
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Compose sets the HTTPS callback from DOMAIN. For local development the default is:
# http://localhost:5173/api/auth/google/callback

# Render + Supabase + OpenRouter (see CLOUD_DEPLOYMENT.md).
DATABASE_URL=
DATABASE_SSLMODE=require
AUTO_MIGRATE=false
DURABLE_JOBS=false
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=eval-ai-documents
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=8192
AI_PARALLEL_JOBS=1
AI_OCR_REASONING_EFFORT=minimal
AI_TEXT_REASONING_EFFORT=low
AI_REQUEST_LOGPROBS=false
PUBLIC_WEB_URL=
