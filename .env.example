# Copy to .env beside compose.yaml. Do not put real secrets in this example.
DOMAIN=eval.example.com
ACME_EMAIL=admin@example.com
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
LOGIN_ATTEMPTS_PER_MINUTE=20
# Private GPU host reachable from the API container. Never publish model ports to the internet.
INTERNVL_API_URL=http://host.docker.internal:11434
INTERNVL_MODEL=blaifa/InternVL3_5:4B
INTERNVL_PARALLEL_JOBS=1
INDIC_OCR_ENABLED=false
INDIC_OCR_URL=http://host.docker.internal:8090
INDIC_TEXT_MODEL=
INDIC_PARALLEL_JOBS=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Compose sets the HTTPS callback from DOMAIN. For local development the default is:
# http://localhost:5173/api/auth/google/callback

# Render + Supabase + OpenRouter (see CLOUD_DEPLOYMENT.md).
DATABASE_URL=
DATABASE_SSLMODE=require
AUTO_MIGRATE=false
DURABLE_JOBS=false
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=eval-ai-documents
AI_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
AI_REQUEST_LOGPROBS=false
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
PUBLIC_WEB_URL=
