INTERNVL_ENABLED=true
INTERNVL_MODEL=blaifa/InternVL3_5:4B
INTERNVL_API_URL=http://127.0.0.1:11434
INTERNVL_TIMEOUT=300
# Indian-language subjects (Tamil, Hindi, ...) are read by IndicOCR; see indic_ocr_service/README.md
INDIC_OCR_ENABLED=true
INDIC_OCR_URL=http://127.0.0.1:8090
INDIC_SUBJECTS=tamil,தமிழ்,hindi,हिन्दी,telugu,kannada,malayalam,marathi,bengali,gujarati,odia,punjabi,assamese,urdu,sanskrit
# Optional: an Ollama model that understands Tamil, to grade and label those subjects (empty = InternVL).
INDIC_TEXT_MODEL=
# Model jobs (reading, identifying, grading) run at once per engine. Keep INTERNVL_PARALLEL_JOBS at or below
# OLLAMA_NUM_PARALLEL on the Ollama machine. 2 suits an 8 GB GPU; raise only if nvidia-smi shows room.
INTERNVL_PARALLEL_JOBS=2
INDIC_PARALLEL_JOBS=2
# Leave SECRET_KEY empty to auto-generate and persist one in data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
DATA_DIR=../data
PDF_RENDER_DPI=300
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOGIN_ATTEMPTS_PER_MINUTE=20
ADMIN_EMAIL=seyamesh91@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
