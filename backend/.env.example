INTERNVL_ENABLED=true
INTERNVL_MODEL=blaifa/InternVL3_5:4B
INTERNVL_API_URL=http://127.0.0.1:11434
INTERNVL_TIMEOUT=300
# Leave SECRET_KEY empty to auto-generate and persist one in data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
DATA_DIR=../data
PDF_RENDER_DPI=300
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase database: use the "Transaction pooler" string (Connect button in the dashboard) and add ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
