INTERNVL_PARALLEL_JOBS=2
INDIC_PARALLEL_JOBS=2
# Empty = SQLite in DATA_DIR. Postgres (e.g. RDS): postgresql+psycopg://user:password@host:5432/adem
DATABASE_URL=
# Leave SECRET_KEY empty to auto-generate and persist one in data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
DATA_DIR=data
PDF_RENDER_DPI=300
MAX_UPLOAD_MB=50
